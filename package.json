{
  "name": "@gui-chat-plugin/present3d",
  "version": "3.0.0",
  "description": "3D shape presentation plugin using ShapeScript for GUI Chat applications",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && vue-tsc -p tsconfig.build.json --emitDeclarationOnly",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:shapescript": "tsx test-shapescript.ts",
    "test:wave": "tsx test-wave-script.ts",
    "quality": "scoria"
  },
  "dependencies": {
    "three": "^0.186.1",
    "three-bvh-csg": "^0.0.18",
    "three-mesh-bvh": "0.9.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "gui-chat-protocol": "^2.3.0",
    "scoria": "^0.4.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vue": "^3.5.44",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  },
  "peerDependencies": {
    "gui-chat-protocol": "^2.1.0",
    "vue": "^3.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:receptron/GUIChatPluginPresent3D.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
